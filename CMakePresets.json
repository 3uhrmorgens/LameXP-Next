{
  "version": 6,
  "configurePresets": [
    {"name":"linux-core", "generator":"Ninja", "binaryDir":"${sourceDir}/out/build/linux-core", "cacheVariables":{"LAMEXP_CORE_ONLY":"ON", "CMAKE_BUILD_TYPE":"Release"}},
    {
      "name": "win-msvc2022-x64",
      "displayName": "Windows x64 - MSVC 2022 / Qt 6",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "architecture": { "value": "x64", "strategy": "external" },
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    }
  ],
  "buildPresets": [
    {"name":"linux-core", "configurePreset":"linux-core"},
    {"name":"win-msvc2022-x64", "configurePreset":"win-msvc2022-x64"}
  ],
  "testPresets": [
    {"name":"linux-core", "configurePreset":"linux-core", "output":{"outputOnFailure":true}},
    {"name":"win-msvc2022-x64", "configurePreset":"win-msvc2022-x64", "output":{"outputOnFailure":true}}
  ]
}
